<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0"
            styleClass="dashboard-root"
            stylesheets="@../../css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ac.uir.gestionhandicap.controller.user.ProfilController">

    <children>

        <AnchorPane prefWidth="250.0"
                    styleClass="sidebar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <children>
                <ImageView fitHeight="44.0" fitWidth="44.0" layoutX="22.0" layoutY="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo_uir.jpg" />
                    </image>
                </ImageView>
                <Label layoutX="78.0" layoutY="35.0" text="UIR" styleClass="sidebar-logo-text" />
                <Label layoutX="22.0" layoutY="88.0" text="Espace utilisateur" styleClass="sidebar-subtitle" />

                <VBox layoutX="14.0" layoutY="130.0" prefWidth="222.0" spacing="6.0">
                    <children>
                        <Button prefHeight="44.0" prefWidth="222.0" text="Accueil" styleClass="sidebar-button" onAction="#handleAccueil" />
                        <Button prefHeight="44.0" prefWidth="222.0" text="Mes demandes" styleClass="sidebar-button" onAction="#handleMesDemandes" />
                        <Button prefHeight="44.0" prefWidth="222.0" text="Mes réclamations" styleClass="sidebar-button" onAction="#handleMesReclamations" />
                        <Button prefHeight="44.0" prefWidth="222.0" text="Nouvelle demande" styleClass="sidebar-button" onAction="#handleNouvelleDemande" />
                        <Button prefHeight="44.0" prefWidth="222.0" text="Nouvelle réclamation" styleClass="sidebar-button" onAction="#handleNouvelleReclamation" />
                        <Button prefHeight="44.0" prefWidth="222.0" text="Profil" styleClass="sidebar-button-active" onAction="#handleProfil" />
                    </children>
                </VBox>

                <Button prefHeight="48.0" prefWidth="222.0"
                        text="Déconnexion"
                        styleClass="logout-button"
                        onAction="#handleLogout"
                        AnchorPane.leftAnchor="14.0"
                        AnchorPane.bottomAnchor="24.0" />
            </children>
        </AnchorPane>

        <AnchorPane prefHeight="88.0"
                    styleClass="topbar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0">
            <children>
                <Label layoutX="36.0" layoutY="28.0" text="Mon profil" styleClass="topbar-title" />
                <HBox alignment="CENTER_RIGHT" spacing="14.0"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.rightAnchor="30.0">
                    <children>
                        <StackPane prefHeight="40.0" prefWidth="40.0" styleClass="avatar-clickable">
                            <children>
                                <Circle radius="20.0" styleClass="avatar" />
                                <Label fx:id="avatarInitialLabel" text="U" styleClass="avatar-initial" />
                            </children>
                        </StackPane>
                        <Label fx:id="userNameLabel" text="Utilisateur" styleClass="topbar-user" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <ScrollPane fitToWidth="true"
                    styleClass="dashboard-scroll"
                    AnchorPane.topAnchor="88.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <content>
                <VBox spacing="20.0" styleClass="dashboard-content">
                    <padding>
                        <Insets top="20.0" right="36.0" bottom="30.0" left="36.0" />
                    </padding>
                    <children>

                        <AnchorPane prefHeight="100.0" styleClass="welcome-banner">
                            <children>
                                <Label layoutX="30.0" layoutY="22.0" text="Mon profil" styleClass="welcome-title" />
                                <Label layoutX="30.0" layoutY="58.0"
                                       text="Gérez vos informations personnelles et votre mot de passe."
                                       styleClass="welcome-subtitle" />
                            </children>
                        </AnchorPane>

                        <HBox spacing="20.0">
                            <children>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="430.0" styleClass="section-card">
                                    <children>
                                        <Label layoutX="28.0" layoutY="22.0" text="Informations personnelles" styleClass="section-title" />
                                        <Label layoutX="28.0" layoutY="54.0" text="Mettez à jour vos coordonnées" styleClass="section-subtitle" />

                                        <Label layoutX="28.0" layoutY="94.0" text="Nom" styleClass="field-label" />
                                        <TextField fx:id="nomField"
                                                   layoutX="28.0" layoutY="118.0"
                                                   prefHeight="44.0"
                                                   AnchorPane.leftAnchor="28.0"
                                                   AnchorPane.rightAnchor="28.0" />

                                        <Label layoutX="28.0" layoutY="178.0" text="Prénom" styleClass="field-label" />
                                        <TextField fx:id="prenomField"
                                                   layoutX="28.0" layoutY="202.0"
                                                   prefHeight="44.0"
                                                   AnchorPane.leftAnchor="28.0"
                                                   AnchorPane.rightAnchor="28.0" />

                                        <Label layoutX="28.0" layoutY="262.0" text="Téléphone" styleClass="field-label" />
                                        <TextField fx:id="telephoneField"
                                                   layoutX="28.0" layoutY="286.0"
                                                   prefHeight="44.0"
                                                   promptText="06 XX XX XX XX"
                                                   AnchorPane.leftAnchor="28.0"
                                                   AnchorPane.rightAnchor="28.0" />

                                        <Button text="Enregistrer"
                                                styleClass="primary-button"
                                                prefHeight="46.0"
                                                prefWidth="200.0"
                                                onAction="#handleSaveProfile"
                                                AnchorPane.leftAnchor="28.0"
                                                AnchorPane.bottomAnchor="28.0" />
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="430.0" styleClass="section-card">
                                    <children>
                                        <Label layoutX="28.0" layoutY="22.0" text="Sécurité" styleClass="section-title" />
                                        <Label layoutX="28.0" layoutY="54.0" text="Modifier votre mot de passe" styleClass="section-subtitle" />

                                        <Label layoutX="28.0" layoutY="94.0" text="Mot de passe actuel" styleClass="field-label" />
                                        <PasswordField fx:id="ancienPasswordField"
                                                       layoutX="28.0" layoutY="118.0"
                                                       prefHeight="44.0"
                                                       AnchorPane.leftAnchor="28.0"
                                                       AnchorPane.rightAnchor="28.0" />

                                        <Label layoutX="28.0" layoutY="178.0" text="Nouveau mot de passe" styleClass="field-label" />
                                        <PasswordField fx:id="nouveauPasswordField"
                                                       layoutX="28.0" layoutY="202.0"
                                                       prefHeight="44.0"
                                                       AnchorPane.leftAnchor="28.0"
                                                       AnchorPane.rightAnchor="28.0" />

                                        <Label layoutX="28.0" layoutY="262.0" text="Confirmer le nouveau mot de passe" styleClass="field-label" />
                                        <PasswordField fx:id="confirmPasswordField"
                                                       layoutX="28.0" layoutY="286.0"
                                                       prefHeight="44.0"
                                                       AnchorPane.leftAnchor="28.0"
                                                       AnchorPane.rightAnchor="28.0" />

                                        <Button text="Mettre à jour"
                                                styleClass="primary-button"
                                                prefHeight="46.0"
                                                prefWidth="200.0"
                                                onAction="#handleChangePassword"
                                                AnchorPane.leftAnchor="28.0"
                                                AnchorPane.bottomAnchor="28.0" />
                                    </children>
                                </AnchorPane>

                            </children>
                        </HBox>

                        <AnchorPane prefHeight="180.0" styleClass="section-card">
                            <children>
                                <Label layoutX="28.0" layoutY="22.0" text="Informations du compte" styleClass="section-title" />
                                <Label layoutX="28.0" layoutY="54.0" text="Données non modifiables" styleClass="section-subtitle" />

                                <Label layoutX="28.0" layoutY="98.0" text="Email" styleClass="field-label" />
                                <Label fx:id="emailLabel" layoutX="28.0" layoutY="120.0" text="—" styleClass="profil-value" />

                                <Label layoutX="320.0" layoutY="98.0" text="Rôle" styleClass="field-label" />
                                <Label fx:id="roleLabel" layoutX="320.0" layoutY="120.0" text="—" styleClass="profil-value" />

                                <Label layoutX="540.0" layoutY="98.0" text="Inscription" styleClass="field-label" />
                                <Label fx:id="dateLabel" layoutX="540.0" layoutY="120.0" text="—" styleClass="profil-value" />

                                <Label layoutX="780.0" layoutY="98.0" text="Statut" styleClass="field-label" />
                                <Label fx:id="statutLabel" layoutX="780.0" layoutY="120.0" text="—" styleClass="profil-value" />
                            </children>
                        </AnchorPane>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
