<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0"
            styleClass="login-root"
            stylesheets="@../../css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ac.uir.gestionhandicap.controller.auth.LoginController">

    <children>

        <AnchorPane prefWidth="560.0"
                    styleClass="left-panel"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <children>
                <ImageView fitHeight="80.0" fitWidth="80.0" layoutX="60.0" layoutY="40.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo_uir.jpg" />
                    </image>
                </ImageView>

                <Label layoutX="80.0" layoutY="190.0" text="Gestion des demandes" styleClass="title-white" />
                <Label layoutX="80.0" layoutY="240.0" text="et réclamations" styleClass="title-white" />

                <Label layoutX="80.0" layoutY="320.0"
                       text="Application dédiée aux personnes en situation"
                       styleClass="subtitle-white" />
                <Label layoutX="80.0" layoutY="345.0"
                       text="de handicap au sein de l'université UIR."
                       styleClass="subtitle-white" />

                <AnchorPane layoutX="80.0" layoutY="400.0" prefHeight="44.0" prefWidth="200.0" styleClass="info-badge">
                    <children>
                        <Label layoutX="25.0" layoutY="12.0" text="Application Desktop" styleClass="info-badge-text" />
                    </children>
                </AnchorPane>

                <AnchorPane layoutX="80.0" layoutY="490.0" prefHeight="240.0" prefWidth="420.0" styleClass="decorative-block">
                    <children>
                        <AnchorPane layoutX="30.0" layoutY="35.0" prefHeight="160.0" prefWidth="170.0" styleClass="decorative-card">
                            <children>
                                <Circle layoutX="85.0" layoutY="55.0" radius="28.0" styleClass="logo-circle" />
                                <Rectangle layoutX="55.0" layoutY="100.0" width="60.0" height="10.0" arcWidth="8" arcHeight="8" fill="#073567" />
                                <Rectangle layoutX="35.0" layoutY="125.0" width="100.0" height="10.0" arcWidth="6" arcHeight="6" fill="#9DB2CC" />
                            </children>
                        </AnchorPane>
                        <Rectangle layoutX="220.0" layoutY="55.0" width="140.0" height="18.0" arcWidth="8" arcHeight="8" fill="#D2D700" />
                        <Rectangle layoutX="220.0" layoutY="85.0" width="115.0" height="12.0" arcWidth="6" arcHeight="6" fill="#C7D2E2" />
                        <Rectangle layoutX="220.0" layoutY="108.0" width="85.0" height="12.0" arcWidth="6" arcHeight="6" fill="#C7D2E2" />
                        <AnchorPane layoutX="220.0" layoutY="145.0" prefHeight="78.0" prefWidth="125.0" styleClass="decorative-card">
                            <children>
                                <Rectangle layoutX="15.0" layoutY="22.0" width="75.0" height="12.0" arcWidth="6" arcHeight="6" fill="#D2D700" />
                                <Rectangle layoutX="15.0" layoutY="46.0" width="55.0" height="10.0" arcWidth="6" arcHeight="6" fill="#C7D2E2" />
                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>
            </children>
        </AnchorPane>

        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.leftAnchor="560.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0">
            <children>
                <AnchorPane prefHeight="510.0" prefWidth="500.0"
                            maxHeight="510.0" maxWidth="500.0"
                            minHeight="510.0" minWidth="500.0"
                            styleClass="login-card">
                    <children>
                        <Label layoutX="40.0" layoutY="40.0" text="Connexion" styleClass="card-title" />

                        <Label layoutX="40.0" layoutY="90.0"
                               text="Veuillez saisir vos identifiants pour accéder à votre espace."
                               styleClass="card-subtitle"
                               wrapText="true"
                               prefWidth="420.0" />

                        <Label layoutX="40.0" layoutY="148.0" text="Email institutionnel" styleClass="field-label" />
                        <TextField fx:id="emailField"
                                   layoutX="40.0" layoutY="172.0"
                                   prefHeight="52.0" prefWidth="420.0"
                                   promptText="nom@uir.ac.ma" />

                        <Label layoutX="40.0" layoutY="240.0" text="Mot de passe" styleClass="field-label" />
                        <PasswordField fx:id="passwordField"
                                       layoutX="40.0" layoutY="264.0"
                                       prefHeight="52.0" prefWidth="420.0"
                                       promptText="Mot de passe" />

                        <Button layoutX="40.0" layoutY="352.0"
                                prefHeight="56.0" prefWidth="420.0"
                                text="Se connecter"
                                styleClass="primary-button"
                                onAction="#handleLogin" />

                        <Button layoutX="40.0" layoutY="440.0"
                                prefHeight="30.0" prefWidth="160.0"
                                text="Créer un compte"
                                styleClass="link-button"
                                onAction="#handleGoToRegister" />

                        <Button layoutX="280.0" layoutY="440.0"
                                prefHeight="30.0" prefWidth="180.0"
                                text="Mot de passe oublié ?"
                                styleClass="link-button-soft" />
                    </children>
                </AnchorPane>
            </children>
        </StackPane>

    </children>
</AnchorPane>
