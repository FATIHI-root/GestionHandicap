<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0"
            styleClass="dashboard-root"
            stylesheets="@../../css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ac.uir.gestionhandicap.controller.admin.ValidationComptesController">

    <children>

        <AnchorPane prefWidth="250.0"
                    styleClass="sidebar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <children>
                <ImageView fitHeight="44.0" fitWidth="44.0" layoutX="22.0" layoutY="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo_uir.jpg" />
                    </image>
                </ImageView>
                <Label layoutX="78.0" layoutY="35.0" text="UIR" styleClass="sidebar-logo-text" />
                <Label layoutX="22.0" layoutY="88.0" text="Espace administrateur" styleClass="sidebar-subtitle" />

                <VBox layoutX="14.0" layoutY="130.0" prefWidth="222.0" spacing="6.0">
                    <children>
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Tableau de bord"
                                styleClass="sidebar-button"
                                onAction="#handleAccueil" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Demandes"
                                styleClass="sidebar-button"
                                onAction="#handleDemandes" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Réclamations"
                                styleClass="sidebar-button"
                                onAction="#handleReclamations" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Archivage"
                                styleClass="sidebar-button"
                                onAction="#handleArchivage" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Validation comptes"
                                styleClass="sidebar-button-active"
                                onAction="#handleValidationComptes" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Statistiques"
                                styleClass="sidebar-button"
                                onAction="#handleStatistiques" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Saisons"
                                styleClass="sidebar-button"
                                onAction="#handleSaisons" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Profil"
                                styleClass="sidebar-button"
                                onAction="#handleProfil" />
                    </children>
                </VBox>

                <Button prefHeight="48.0" prefWidth="222.0"
                        text="Déconnexion"
                        styleClass="logout-button"
                        onAction="#handleLogout"
                        AnchorPane.leftAnchor="14.0"
                        AnchorPane.bottomAnchor="24.0" />
            </children>
        </AnchorPane>

        <AnchorPane prefHeight="88.0"
                    styleClass="topbar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0">
            <children>
                <Label layoutX="36.0" layoutY="28.0" text="Validation des comptes" styleClass="topbar-title" />

                <HBox alignment="CENTER_RIGHT" spacing="14.0"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.rightAnchor="30.0">
                    <children>
                        <TextField fx:id="searchField"
                                   prefHeight="40.0" prefWidth="220.0"
                                   promptText="Recherche..."
                                   styleClass="search-box" />

                        <StackPane prefHeight="40.0" prefWidth="40.0" styleClass="avatar-clickable" onMouseClicked="#handleProfil">
                            <children>
                                <Circle radius="20.0" styleClass="avatar" />
                                <Label fx:id="avatarInitialLabel" text="A" styleClass="avatar-initial" />
                            </children>
                        </StackPane>

                        <Label fx:id="userNameLabel" text="Admin UIR" styleClass="topbar-user" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <ScrollPane fitToWidth="true"
                    styleClass="dashboard-scroll"
                    AnchorPane.topAnchor="88.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <content>
                <VBox spacing="20.0" styleClass="dashboard-content">
                    <padding>
                        <Insets top="20.0" right="36.0" bottom="30.0" left="36.0" />
                    </padding>
                    <children>

                        <AnchorPane prefHeight="86.0" styleClass="welcome-banner">
                            <children>
                                <Label layoutX="30.0" layoutY="22.0"
                                       text="Vérification des inscriptions"
                                       styleClass="welcome-title" />
                                <Label layoutX="30.0" layoutY="54.0"
                                       text="Consultez les documents justificatifs puis acceptez ou refusez les comptes."
                                       styleClass="welcome-subtitle" />
                                <Button prefHeight="42.0" prefWidth="230.0"
                                        text="Exporter (CSV/Excel/PDF)"
                                        styleClass="primary-button"
                                        onAction="#handleExport"
                                        AnchorPane.topAnchor="22.0"
                                        AnchorPane.rightAnchor="24.0" />
                            </children>
                        </AnchorPane>

                        <HBox spacing="20.0">
                            <children>
                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="110.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Comptes en attente" styleClass="stat-label" />
                                        <Label fx:id="statEnAttenteLabel" layoutX="22.0" layoutY="50.0" text="0" styleClass="stat-number" />
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="110.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Validés ce mois" styleClass="stat-label" />
                                        <Label fx:id="statValidesLabel" layoutX="22.0" layoutY="50.0" text="0" styleClass="stat-number" />
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="110.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Refusés" styleClass="stat-label" />
                                        <Label fx:id="statRefusesLabel" layoutX="22.0" layoutY="50.0" text="0" styleClass="stat-number" />
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="110.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Documents reçus" styleClass="stat-label" />
                                        <Label fx:id="statTotalLabel" layoutX="22.0" layoutY="50.0" text="0" styleClass="stat-number" />
                                    </children>
                                </AnchorPane>
                            </children>
                        </HBox>

                        <AnchorPane prefHeight="460.0" styleClass="section-card">
                            <children>
                                <Label layoutX="28.0" layoutY="22.0" text="Comptes à vérifier" styleClass="section-title" />
                                <Label layoutX="28.0" layoutY="54.0"
                                       text="Filtrez par statut, puis validez ou refusez chaque inscription."
                                       styleClass="section-subtitle" />

                                <Label layoutX="28.0" layoutY="98.0" text="Filtrer par statut :" styleClass="field-label" />
                                <ComboBox fx:id="filtreCombo"
                                          layoutX="160.0" layoutY="92.0"
                                          prefHeight="36.0" prefWidth="200.0" />

                                <TableView fx:id="comptesTable"
                                           prefHeight="280.0"
                                           AnchorPane.topAnchor="146.0"
                                           AnchorPane.leftAnchor="24.0"
                                           AnchorPane.rightAnchor="24.0"
                                           AnchorPane.bottomAnchor="24.0">
                                    <columns>
                                        <TableColumn fx:id="colNomComplet" text="Nom complet" prefWidth="180.0" />
                                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220.0" />
                                        <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="120.0" />
                                        <TableColumn fx:id="colDate" text="Inscription" prefWidth="110.0" />
                                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="110.0" />
                                        <TableColumn fx:id="colDocument" text="Document" prefWidth="100.0" />
                                        <TableColumn fx:id="colActions" text="Actions" prefWidth="200.0" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
