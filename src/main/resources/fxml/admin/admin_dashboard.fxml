<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0"
            styleClass="dashboard-root"
            stylesheets="@../../css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ac.uir.gestionhandicap.controller.admin.AdminDashboardController">

    <children>

        <AnchorPane prefWidth="250.0"
                    styleClass="sidebar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <children>
                <ImageView fitHeight="44.0" fitWidth="44.0" layoutX="22.0" layoutY="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo_uir.jpg" />
                    </image>
                </ImageView>
                <Label layoutX="78.0" layoutY="35.0" text="UIR" styleClass="sidebar-logo-text" />
                <Label layoutX="22.0" layoutY="88.0" text="Espace administrateur" styleClass="sidebar-subtitle" />

                <VBox layoutX="14.0" layoutY="130.0" prefWidth="222.0" spacing="6.0">
                    <children>
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Tableau de bord"
                                styleClass="sidebar-button-active"
                                onAction="#handleAccueil" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Demandes"
                                styleClass="sidebar-button"
                                onAction="#handleDemandes" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Réclamations"
                                styleClass="sidebar-button"
                                onAction="#handleReclamations" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Archivage"
                                styleClass="sidebar-button"
                                onAction="#handleArchivage" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Validation comptes"
                                styleClass="sidebar-button"
                                onAction="#handleValidationComptes" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Statistiques"
                                styleClass="sidebar-button"
                                onAction="#handleStatistiques" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Saisons"
                                styleClass="sidebar-button"
                                onAction="#handleSaisons" />
                        <Button prefHeight="44.0" prefWidth="222.0"
                                text="Profil"
                                styleClass="sidebar-button"
                                onAction="#handleProfil" />
                    </children>
                </VBox>

                <Button prefHeight="48.0" prefWidth="222.0"
                        text="Déconnexion"
                        styleClass="logout-button"
                        onAction="#handleLogout"
                        AnchorPane.leftAnchor="14.0"
                        AnchorPane.bottomAnchor="24.0" />
            </children>
        </AnchorPane>

        <AnchorPane prefHeight="88.0"
                    styleClass="topbar"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0">
            <children>
                <Label layoutX="36.0" layoutY="28.0" text="Dashboard Administrateur" styleClass="topbar-title" />

                <HBox alignment="CENTER_RIGHT" spacing="14.0"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.rightAnchor="30.0">
                    <children>
                        <TextField fx:id="searchField"
                                   prefHeight="40.0" prefWidth="220.0"
                                   promptText="Recherche..."
                                   styleClass="search-box" />

                        <StackPane prefHeight="40.0" prefWidth="40.0" styleClass="avatar-clickable" onMouseClicked="#handleProfil">
                            <children>
                                <Circle radius="20.0" styleClass="avatar" />
                                <Label fx:id="avatarInitialLabel" text="A" styleClass="avatar-initial" />
                            </children>
                        </StackPane>

                        <Label fx:id="userNameLabel" text="Admin UIR" styleClass="topbar-user" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <ScrollPane fitToWidth="true"
                    styleClass="dashboard-scroll"
                    AnchorPane.topAnchor="88.0"
                    AnchorPane.leftAnchor="250.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <content>
                <VBox spacing="20.0" styleClass="dashboard-content">
                    <padding>
                        <Insets top="20.0" right="36.0" bottom="30.0" left="36.0" />
                    </padding>
                    <children>

                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <ComboBox fx:id="filtrePeriodeCombo"
                                          prefHeight="40.0" prefWidth="170.0"
                                          promptText="Période" />
                                <ComboBox fx:id="filtreSaisonCombo"
                                          prefHeight="40.0" prefWidth="170.0"
                                          promptText="Saison" />
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Button prefHeight="40.0" prefWidth="200.0"
                                        text="Exporter (CSV/Excel/PDF)"
                                        styleClass="secondary-button"
                                        onAction="#handleExport" />
                                <Button prefHeight="40.0" prefWidth="170.0"
                                        text="Valider les comptes"
                                        styleClass="primary-button"
                                        onAction="#handleValidationComptes" />
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="118.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Demandes totales" styleClass="stat-label" />
                                        <Label fx:id="statDemandesLabel" layoutX="22.0" layoutY="50.0" text="—" styleClass="stat-number" />
                                        <AnchorPane layoutY="22.0" prefHeight="28.0" prefWidth="68.0" styleClass="badge-success"
                                                    AnchorPane.rightAnchor="20.0">
                                            <children>
                                                <Label layoutX="14.0" layoutY="6.0" text="+12%" styleClass="badge-success-text" />
                                            </children>
                                        </AnchorPane>
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="118.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Demandes en cours" styleClass="stat-label" />
                                        <Label fx:id="statEnCoursLabel" layoutX="22.0" layoutY="50.0" text="—" styleClass="stat-number" />
                                        <AnchorPane layoutY="22.0" prefHeight="28.0" prefWidth="70.0" styleClass="badge-warning"
                                                    AnchorPane.rightAnchor="20.0">
                                            <children>
                                                <Label layoutX="14.0" layoutY="6.0" text="Actives" styleClass="badge-warning-text" />
                                            </children>
                                        </AnchorPane>
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="118.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Réclamations" styleClass="stat-label" />
                                        <Label fx:id="statReclamationsLabel" layoutX="22.0" layoutY="50.0" text="—" styleClass="stat-number" />
                                        <AnchorPane layoutY="22.0" prefHeight="28.0" prefWidth="70.0" styleClass="badge-warning"
                                                    AnchorPane.rightAnchor="20.0">
                                            <children>
                                                <Label layoutX="11.0" layoutY="6.0" text="Ouvertes" styleClass="badge-warning-text" />
                                            </children>
                                        </AnchorPane>
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="118.0" styleClass="stat-card">
                                    <children>
                                        <Label layoutX="22.0" layoutY="22.0" text="Comptes à valider" styleClass="stat-label" />
                                        <Label fx:id="statEnAttenteLabel" layoutX="22.0" layoutY="50.0" text="—" styleClass="stat-number" />
                                        <AnchorPane layoutY="22.0" prefHeight="28.0" prefWidth="60.0" styleClass="badge-warning"
                                                    AnchorPane.rightAnchor="20.0">
                                            <children>
                                                <Label layoutX="18.0" layoutY="6.0" text="Docs" styleClass="badge-warning-text" />
                                            </children>
                                        </AnchorPane>
                                    </children>
                                </AnchorPane>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <AnchorPane prefWidth="470.0" prefHeight="292.0" styleClass="section-card">
                                    <children>
                                        <Label layoutX="28.0" layoutY="22.0" text="Statistiques des demandes" styleClass="section-title" />
                                        <Label layoutX="28.0" layoutY="50.0" text="Répartition par statut" styleClass="section-subtitle" />
                                        <PieChart fx:id="demandesPieChart"
                                                  legendVisible="true"
                                                  labelsVisible="true"
                                                  AnchorPane.topAnchor="74.0"
                                                  AnchorPane.leftAnchor="14.0"
                                                  AnchorPane.rightAnchor="14.0"
                                                  AnchorPane.bottomAnchor="14.0" />
                                    </children>
                                </AnchorPane>

                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="292.0" styleClass="section-card">
                                    <children>
                                        <Label layoutX="28.0" layoutY="22.0" text="Comptes à valider" styleClass="section-title" />
                                        <Label layoutX="28.0" layoutY="50.0" text="Vérification des documents justificatifs" styleClass="section-subtitle" />

                                        <HBox layoutY="92.0" prefHeight="38.0" spacing="0.0"
                                              AnchorPane.leftAnchor="28.0"
                                              AnchorPane.rightAnchor="28.0">
                                            <children>
                                                <Label prefWidth="180.0" text="Nom" styleClass="section-subtitle" />
                                                <Label prefWidth="170.0" text="Email" styleClass="section-subtitle" />
                                                <Label prefWidth="100.0" text="Date" styleClass="section-subtitle" />
                                                <Label text="Action" styleClass="section-subtitle" />
                                            </children>
                                        </HBox>

                                        <VBox fx:id="comptesValiderBox" spacing="10.0"
                                              layoutY="138.0"
                                              AnchorPane.leftAnchor="28.0"
                                              AnchorPane.rightAnchor="28.0" />
                                    </children>
                                </AnchorPane>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <AnchorPane HBox.hgrow="ALWAYS" prefHeight="340.0" styleClass="section-card">
                                    <children>
                                        <Label layoutX="28.0" layoutY="22.0" text="Demandes récentes" styleClass="section-title" />
                                        <Label layoutX="28.0" layoutY="50.0" text="Liste des derniers dossiers soumis" styleClass="section-subtitle" />

                                        <HBox layoutY="92.0" prefHeight="38.0"
                                              AnchorPane.leftAnchor="28.0"
                                              AnchorPane.rightAnchor="28.0">
                                            <children>
                                                <Label prefWidth="80.0" text="ID" styleClass="section-subtitle" />
                                                <Label prefWidth="200.0" text="Type" styleClass="section-subtitle" />
                                                <Label prefWidth="140.0" text="Étudiant" styleClass="section-subtitle" />
                                                <Label prefWidth="110.0" text="Statut" styleClass="section-subtitle" />
                                                <Label text="Action" styleClass="section-subtitle" />
                                            </children>
                                        </HBox>

                                        <VBox fx:id="demandesRecentesBox" spacing="10.0"
                                              layoutY="138.0"
                                              AnchorPane.leftAnchor="28.0"
                                              AnchorPane.rightAnchor="28.0" />
                                    </children>
                                </AnchorPane>

                                <VBox spacing="20.0" prefWidth="320.0">
                                    <children>
                                        <AnchorPane prefHeight="160.0" styleClass="section-card">
                                            <children>
                                                <Label layoutX="24.0" layoutY="20.0" text="Réclamations" styleClass="section-title" />
                                                <Label layoutX="24.0" layoutY="52.0" text="Suivi rapide des derniers cas" styleClass="section-subtitle" />

                                                <VBox fx:id="reclamationsRecentesBox" spacing="8.0"
                                                      layoutY="84.0"
                                                      AnchorPane.leftAnchor="24.0"
                                                      AnchorPane.rightAnchor="24.0" />
                                            </children>
                                        </AnchorPane>

                                        <AnchorPane prefHeight="160.0" styleClass="dark-panel">
                                            <children>
                                                <Label layoutX="24.0" layoutY="22.0" text="Actions rapides" styleClass="dark-panel-title" />
                                                <Label layoutX="24.0" layoutY="54.0" text="Accès direct aux tâches admin" styleClass="dark-panel-subtitle" />

                                                <Button prefHeight="42.0"
                                                        text="Valider les comptes"
                                                        styleClass="primary-button"
                                                        onAction="#handleValidationComptes"
                                                        AnchorPane.topAnchor="84.0"
                                                        AnchorPane.leftAnchor="24.0"
                                                        AnchorPane.rightAnchor="24.0" />
                                                <Button prefHeight="42.0"
                                                        text="Ouvrir l'archivage"
                                                        styleClass="action-button-dark"
                                                        onAction="#handleArchivage"
                                                        AnchorPane.topAnchor="134.0"
                                                        AnchorPane.leftAnchor="24.0"
                                                        AnchorPane.rightAnchor="24.0" />
                                            </children>
                                        </AnchorPane>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <PieChart fx:id="reclamationsPieChart"
                                  visible="false"
                                  managed="false" />

                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
